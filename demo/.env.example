# Optional settings for ./demo.sh — copy to demo/.env. Everything works without them.

# Google Places for richer destination search (otherwise Photon / OpenStreetMap).
GMAPS_API_KEY=

# MapTiler base map (otherwise the keyless OpenFreeMap styles).
EXPO_PUBLIC_MAPTILER_KEY=

# Socrata app token for data.calgary.ca (raises the rate limit; not required).
SOCRATA_APP_TOKEN=

# auto = live Calgary feeds, falling back to demo/recordings when offline.
# replay = always use the recording.  live = never fall back.
FEED_MODE=auto

# Host port for the demo Postgres (user tranzit / password tranzit).
PG_PORT=5433
