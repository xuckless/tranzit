# Copy to .env and fill in.
#
# Reusable, non-ephemeral auth key from https://login.tailscale.com/admin/settings/keys
# (Reusable + non-ephemeral recommended so the node survives restarts.)
# Leave empty to log in interactively via the URL in `docker compose logs -f tailscale`.
TS_AUTHKEY=

# Postgres superuser/role password (role: tranzit-user, db: tranzit-user).
POSTGRES_PASSWORD=change-me
