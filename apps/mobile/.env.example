# Copy to .env.local and fill in. Nothing here is committed.
#
# Expo exposes only EXPO_PUBLIC_* to the app bundle. Treat every EXPO_PUBLIC_
# value as readable by anyone who installs the build — put nothing secret in one.

# ─── Supabase (auth + user data) ──────────────────────────────────────────────
EXPO_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=

# ─── Map tiles ────────────────────────────────────────────────────────────────
# Free tier is plenty for development: https://cloud.maptiler.com/account/keys/
EXPO_PUBLIC_MAPTILER_KEY=

# ─── Tranzit backend services ─────────────────────────────────────────────────
# Base URLs, no trailing slash. These are whatever your own deployment serves
# on — a Tailscale Funnel hostname, Cloud Run, a reverse proxy, or localhost.
EXPO_PUBLIC_ROUTE_SERVICE_URL=https://route-service.example.com
EXPO_PUBLIC_ROUTE_SAVE_URL=https://route-save.example.com
EXPO_PUBLIC_MIDDLEWARE_URL=https://db-middleware.example.com

# Set to "true" to point the app at a Route Service on http://localhost:3100
# instead of EXPO_PUBLIC_ROUTE_SERVICE_URL.
EXPO_PUBLIC_USE_LOCAL=false
