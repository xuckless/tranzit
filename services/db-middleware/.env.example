# DB Middleware — copy to .env and fill in. Never commit .env.

# ── Listen ─────────────────────────────────────────────────────────────────────
PORT=8080

# ── Databases ──────────────────────────────────────────────────────────────────
# Primary store (Supabase or any Postgres). Full libpq/pgx connection string.
SUPABASE_DIRECT_CONNECTION_STRING=postgres://user:pass@host:5432/postgres

# Self-hosted user database (see infra/user-db). Optional; leave unset to use
# only the primary store above.
# Prefer a stable IP over a DNS name here: when the Tailscale sidecar runs with
# --accept-dns=false, the container's resolver cannot see MagicDNS names.
TRANZIT_USER_DB_CONNECTION_STRING=

# ── Auth (see AUTH.md) ─────────────────────────────────────────────────────────
# End-user access tokens (ES256) are verified against this project's JWKS at
# ${SUPABASE_URL}/auth/v1/.well-known/jwks.json. Not a secret.
SUPABASE_URL=https://your-project.supabase.co
# false = log-only (soft rollout), true = reject unauthenticated requests.
AUTH_ENFORCE=false

# ── Service-to-service mTLS (private network only; never publish this port) ────
# Leave MTLS_LISTEN_ADDR unset to disable the mTLS listener entirely.
MTLS_LISTEN_ADDR=
MTLS_CA_CERT=/certs/ca.crt
MTLS_CERT=/certs/server.crt
MTLS_KEY=/certs/server.key
# Comma-separated client certificate CNs permitted to call this service.
MTLS_ALLOWED_CLIENTS=route-service,route-save

# ── Tailscale sidecar (optional; see the deployment notes in the README) ───────
# A reusable, non-ephemeral auth key from the Tailscale admin console.
TS_AUTHKEY=
