# Route Service — copy to .env and fill in. Never commit .env.

# ── Listen ─────────────────────────────────────────────────────────────────────
PORT=3100

# ── Google Maps ────────────────────────────────────────────────────────────────
# Routes + Places key. Leave empty to search places via Photon/OSM instead
# (PHOTON_URL below); POST /route (Google Routes) still needs it.
# https://console.cloud.google.com/apis/credentials
GMAPS_API_KEY=
# Photon geocoder base used when GMAPS_API_KEY is empty.
# PHOTON_URL=https://photon.komoot.io

# ── Siblings ───────────────────────────────────────────────────────────────────
OTP_BASE_URL=http://otp:8080
MIDDLEWARE_BASE_URL=https://db-middleware.example.com

# ── Auth (see AUTH.md) ─────────────────────────────────────────────────────────
SUPABASE_URL=https://your-project.supabase.co
# true (default) = reject unauthenticated requests; false = log-only soft rollout.
AUTH_ENFORCE=true
# Demo stack only: every request is this user, auth disabled, SUPABASE_URL unused.
# DEMO_USER_ID=

# ── mTLS server — siblings call this service privately, never over the public URL
MTLS_LISTEN_ADDR=
MTLS_CA_CERT=/certs/ca.crt
MTLS_CERT=/certs/server.crt
MTLS_KEY=/certs/server.key
MTLS_ALLOWED_CLIENTS=route-save

# ── mTLS client — this service calls DB Middleware ─────────────────────────────
# Set middleware's private mTLS host:port to stop falling back to its public URL.
MIDDLEWARE_MTLS_ADDR=
MIDDLEWARE_MTLS_SERVERNAME=db-middleware

# ── Tailscale sidecar (optional) ───────────────────────────────────────────────
TS_AUTHKEY=
