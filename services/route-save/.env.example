# Route Save — copy to .env and fill in. Never commit .env.
# Loaded by godotenv at startup; real environment variables win over this file.

# ── Listen ─────────────────────────────────────────────────────────────────────
# Route Save's own HTTP + WebSocket address (a bare port is :-prefixed).
PORT=8090

# ── Siblings ───────────────────────────────────────────────────────────────────
MIDDLEWARE_URL=https://db-middleware.example.com
ROUTE_SERVICE_URL=https://route-service.example.com

# ── Auth (see AUTH.md) ─────────────────────────────────────────────────────────
# Required — the service refuses to start without it. Not a secret (the mobile
# client carries the same value).
SUPABASE_URL=https://your-project.supabase.co

# ── Service-to-service mTLS (Route Save is a client only) ──────────────────────
MTLS_CA_CERT=/certs/ca.crt
MTLS_CERT=/certs/client.crt
MTLS_KEY=/certs/client.key
# Set a sibling's private host:port to route calls over mTLS instead of the
# public URLs above. ServerName must match that sibling's certificate SAN.
MIDDLEWARE_MTLS_ADDR=
ROUTE_SERVICE_MTLS_ADDR=
MIDDLEWARE_MTLS_SERVERNAME=db-middleware
ROUTE_SERVICE_MTLS_SERVERNAME=route-service

# ── Logging ────────────────────────────────────────────────────────────────────
# Tabular STATE logging to stdout. On by default; set to 0 to silence.
LOG_STATE=1

# ── Tailscale sidecar (optional) ───────────────────────────────────────────────
TS_AUTHKEY=
