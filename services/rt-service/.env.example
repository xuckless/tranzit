# Realtime Service — copy to .env and fill in. Never commit .env.

# ── Listen ─────────────────────────────────────────────────────────────────────
PORT=8070

# ── Calgary open-data feed (Socrata / SODA 2.0) ────────────────────────────────
# Create an app token and API key at https://data.calgary.ca/profile/edit/developer_settings
APP_TOKEN=
API_KEY_ID=
API_KEY_SECRET=
# Shared secret required on this service's own admin endpoints.
SECRET_TOKEN=

# ── Realtime database (GTFS-RT upserts land here) ──────────────────────────────
DB_HOST=localhost
DB_PORT=5432
DB_NAME=tranzit
DB_USER=tranzit
DB_PASSWORD=

# ── Supabase ───────────────────────────────────────────────────────────────────
SUPABASE_PROJECT_URL=https://your-project.supabase.co
SUPABASE_PUBLISHABLE_KEY=
SUPABASE_DIRECT_CONNECTION_STRING=postgres://user:pass@host:5432/postgres
SUPABASE_HOST=
SUPABASE_PORT=5432
SUPABASE_DB=postgres
SUPABASE_USER=
SUPABASE_PASS=

# ── Container registry (only needed to push images from CI) ────────────────────
DOCKER_PAT=

# ── Tailscale sidecar (optional) ───────────────────────────────────────────────
TS_AUTHKEY=
